@prefix : <https://w3id.org/miUrba#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/miUrba#> .

<https://w3id.org/miUrba> rdf:type owl:Ontology ;
                           owl:versionIRI <https://w3id.org/miUrba/1.0.0> ;
                           <http://purl.org/dc/terms/creator> "Lucía Sánchez-González"@es ,
                                                              "Oscar Corcho"@es ;
                           <http://purl.org/dc/terms/description> "Ontología para describir comunidades de vecinos."@es ;
                           <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                           <http://purl.org/dc/terms/title> "miUrba Ontology" ;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "miUrba" ;
                           <http://purl.org/vocab/vann/preferredNamespaceUri> : .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#municipio
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#municipio> rdf:type owl:ObjectProperty ;
                                                                                   rdfs:comment "Municipio al que pertenece un fenómeno geográfico o una entidad administrativa"@es ;
                                                                                   rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#> ;
                                                                                   rdfs:label "pertenece al municipio"@es .


###  http://www.opengis.net/ont/geosparql#hasGeometry
<http://www.opengis.net/ont/geosparql#hasGeometry> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.opengis.net/ont/geosparql#Feature> ;
                                                   rdfs:range <http://www.opengis.net/ont/geosparql#Geometry> ;
                                                   rdfs:comment "Una representación espacial de un feature determinado."@es ;
                                                   rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0> ;
                                                   rdfs:label "has geometry"@en ,
                                                              "tiene geometría"@es .


###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:ObjectProperty ;
                                               rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core#> .


###  https://edint.es/def/infraestructura#belongsTo
<https://edint.es/def/infraestructura#belongsTo> rdf:type owl:ObjectProperty ;
                                                 rdfs:range [ rdf:type owl:Class ;
                                                              owl:unionOf ( <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio>
                                                                            <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad>
                                                                            <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito>
                                                                            <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio>
                                                                          )
                                                            ] ;
                                                 rdfs:comment "Relación entre un elemento de infraestructura y la división administrativa a la cual pertenece, incluido un Barrio."@es ,
                                                              "Relationship between an infrastructure element and the administrative division to which it belongs, including a neighborhood."@en ;
                                                 rdfs:isDefinedBy <https://edint.es/def/infraestructura#> ;
                                                 rdfs:label "belongs To"@en ,
                                                            "pertenece a"@es .


###  https://schema.org/address
<https://schema.org/address> rdf:type owl:ObjectProperty ;
                             rdfs:domain :Edificio ;
                             rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal> ;
                             rdfs:comment "Dirección física del elemento"@es ,
                                          "Physical address of the item."@en ;
                             rdfs:isDefinedBy <https://schema.org/> ;
                             rdfs:label "address"@en .


###  https://w3id.org/miUrba#correspondeAServicio
:correspondeAServicio rdf:type owl:ObjectProperty ;
                      rdfs:domain :ServicioContratado ;
                      rdfs:range :Servicio ;
                      rdfs:comment "Relaciona un servicio contratado con el servicio al que corresponde"@es ,
                                   "Relates a contracted service to the service it corresponds to"@en ;
                      rdfs:label "corresponde a servicio"@es ,
                                 "corresponds to service"@en .


###  https://w3id.org/miUrba#correspondeAServicioContratado
:correspondeAServicioContratado rdf:type owl:ObjectProperty ;
                                rdfs:domain :GastoComunitario ;
                                rdfs:range :ServicioContratado ;
                                rdfs:comment "It links a community expense to the contracted service it corresponds to."@en ,
                                             "Relaciona un gasto de la comunidad con el servicio contratado al que corresponde."@es ;
                                rdfs:label "corresponde a servicio contratado"@es ,
                                           "corresponds to contracted service"@en .


###  https://w3id.org/miUrba#cubreInstalacionComun
:cubreInstalacionComun rdf:type owl:ObjectProperty ;
                       rdfs:domain :ServicioContratado ;
                       rdfs:range :InstalacionComun ;
                       rdfs:comment "Relaciona un servicio con la instalación común sobre la que se presta o actúa."@es ,
                                    "Relates a service to the communal facility on which it is provided or acts."@en ;
                       rdfs:label "covers communal facility"@en ,
                                  "cubre instalación común"@es .


###  https://w3id.org/miUrba#disponeDeInstalacionComun
:disponeDeInstalacionComun rdf:type owl:ObjectProperty ;
                           rdfs:domain :Edificio ;
                           rdfs:range :InstalacionComun ;
                           rdfs:comment "Relaciona un edificio con una instalación común disponible para sus residentes."@es ,
                                        "Relates a building to a communal facility available to its residents."@en ;
                           rdfs:label "dispone de instalación común"@es ,
                                      "has communal facility"@en .


###  https://w3id.org/miUrba#ejercidoPor
:ejercidoPor rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ;
             rdfs:domain :RolComunitario ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( <https://schema.org/Organization>
                                        <https://schema.org/Person>
                                      )
                        ] ;
             rdfs:comment "Relaciona un rol comunitario con la persona u organización que lo ejerce."@es ,
                          "Relates a community role to the person or organization that performs it."@en ;
             rdfs:label "ejercido por"@es ,
                        "performed by"@en .


###  https://w3id.org/miUrba#formadaPor
:formadaPor rdf:type owl:ObjectProperty ;
            rdfs:domain :ComunidadDeVecinos ;
            rdfs:range :Edificio ;
            rdfs:comment "Relaciona una comunidad de vecinos con los edificios que la conforman."@es ,
                         "Relates a homeowners' community to the buildings that compose it"@en ;
            rdfs:label "composed of"@en ,
                       "formado por"@es .


###  https://w3id.org/miUrba#modalidadDeServicio
:modalidadDeServicio rdf:type owl:ObjectProperty ;
                     rdfs:domain :ServicioContratado ;
                     rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                         owl:hasValue :modalidadServicio
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                     rdfs:comment "Relaciona un servicio contratado con la modalidad bajo la que se presta."@es ,
                                  "Relates a contracted service to the modality under which it is provided."@en ;
                     rdfs:label "modalidad de servicio"@es ,
                                "service modality"@en .


###  https://w3id.org/miUrba#modalidadDeSuministro
:modalidadDeSuministro rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :SistemaACS
                                                   :SistemaDeCalefaccion
                                                 )
                                   ] ;
                       rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                           owl:hasValue :modalidadSuministro
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                       rdfs:comment "Relaciona un sistema térmico con la modalidad mediante la que se suministra calefacción o agua caliente sanitaria."@es ,
                                    "Relates a thermal system to the modality through which heating or domestic hot water is supplied."@en ;
                       rdfs:label "modalidad de suministro"@es ,
                                  "supply modality"@en .


###  https://w3id.org/miUrba#prestadoPor
:prestadoPor rdf:type owl:ObjectProperty ;
             rdfs:domain :ServicioContratado ;
             rdfs:range :Proveedor ;
             rdfs:comment "Relaciona un servicio contratado con el proveedor encargado de prestarlo."@es ,
                          "Relates a contracted service to the provider responsible for delivering it."@en ;
             rdfs:label "prestado por"@es ,
                        "provided by"@en .


###  https://w3id.org/miUrba#tieneContrato
:tieneContrato rdf:type owl:ObjectProperty ;
               rdfs:domain :ServicioContratado ;
               rdfs:range :Contrato ;
               rdfs:comment "Relaciona un servicio contratado con el contrato que regula su prestación."@es ,
                            "Relates a contracted service to the contract that governs its provision."@en ;
               rdfs:label "has contract"@en ,
                          "tiene contrato"@es .


###  https://w3id.org/miUrba#tieneCuotaComunitaria
:tieneCuotaComunitaria rdf:type owl:ObjectProperty ;
                       rdfs:domain :ComunidadDeVecinos ;
                       rdfs:range :CuotaComunitaria ;
                       rdfs:comment "Relaciona una comunidad de vecinos con una cuota comunitaria asociada."@es ,
                                    "Relates a homeowners' community to an associated community fee."@en ;
                       rdfs:label "has community fee"@en ,
                                  "tiene cuota comunitaria"@es .


###  https://w3id.org/miUrba#tieneFrecuenciaDeServicio
:tieneFrecuenciaDeServicio rdf:type owl:ObjectProperty ;
                           rdfs:domain :ServicioContratado ;
                           rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                               owl:hasValue :frecuenciaServicio
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                           rdfs:comment "Relaciona un servicio contratado con la frecuencia con la que se presta."@es ,
                                        "Relates a contracted service to the frequency at which it is provided."@en ;
                           rdfs:label "has service frequency"@en ,
                                      "tiene frecuencia de servicio"@es .


###  https://w3id.org/miUrba#tieneGastoComunitario
:tieneGastoComunitario rdf:type owl:ObjectProperty ;
                       rdfs:domain :ComunidadDeVecinos ;
                       rdfs:range :GastoComunitario ;
                       rdfs:comment "Relaciona una comunidad de vecinos con un gasto comunitario asociado."@es ,
                                    "Relates a homeowners' community to an associated community expense"@en ;
                       rdfs:label "has community expense"@en ,
                                  "tiene gasto comunitario"@es .


###  https://w3id.org/miUrba#tieneInmueble
:tieneInmueble rdf:type owl:ObjectProperty ;
               rdfs:domain :Edificio ;
               rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralProperty> ;
               rdfs:comment "Relaciona un edificio con el inmueble catastral que lo representa."@es ,
                            "Relates a building to the cadastral property that represents it."@en ;
               rdfs:label "has cadastral property"@en ,
                          "tiene inmueble"@es .


###  https://w3id.org/miUrba#tieneReferenciaCatastral
:tieneReferenciaCatastral rdf:type owl:ObjectProperty ;
                          rdfs:domain :Edificio ;
                          rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralReference> ;
                          rdfs:comment "Relaciona un edificio con su referencia catastral."@es ,
                                       "Relates a building to its cadastral reference."@en ;
                          rdfs:label "has cadastral reference"@en ,
                                     "tiene referencia catastral"@es .


###  https://w3id.org/miUrba#tieneRol
:tieneRol rdf:type owl:ObjectProperty ;
          rdfs:domain :ComunidadDeVecinos ;
          rdfs:range :RolComunitario ;
          rdfs:comment "Relaciona una comunidad de vecinos con un rol comunitario asociado."@es ,
                       "Relates a homeowners' community to an associated community role."@en ;
          rdfs:label "has role"@en ,
                     "tiene rol"@es .


###  https://w3id.org/miUrba#tieneSistemaDeACS
:tieneSistemaDeACS rdf:type owl:ObjectProperty ;
                   rdfs:domain :Edificio ;
                   rdfs:range :SistemaACS ;
                   rdfs:comment "Relaciona un edificio con su sistema de agua caliente sanitaria."@es ,
                                "Relates a building to its domestic hot water system."@en ;
                   rdfs:label "has domestic hot water system"@en ,
                              "tiene sistema de ACS"@es .


###  https://w3id.org/miUrba#tieneSistemaDeCalefaccion
:tieneSistemaDeCalefaccion rdf:type owl:ObjectProperty ;
                           rdfs:domain :Edificio ;
                           rdfs:range :SistemaDeCalefaccion ;
                           rdfs:comment "Relaciona un edificio con su sistema de calefacción."@es ,
                                        "Relates a building to its heating system."@en ;
                           rdfs:label "has heating system"@en ,
                                      "tiene sistema de calefacción"@es .


###  https://w3id.org/miUrba#tieneTipoDeServicio
:tieneTipoDeServicio rdf:type owl:ObjectProperty ;
                     rdfs:domain :Servicio ;
                     rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                         owl:hasValue :tipoServicio
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                     rdfs:comment "Relaciona un servicio con el tipo de servicio que lo clasifica."@es ,
                                  "Relates a service to the service type used to classify it"@en ;
                     rdfs:label "has service type"@en ,
                                "tiene tipo de servicio"@es .


###  https://w3id.org/miUrba#tipoDeFuenteEnergetica
:tipoDeFuenteEnergetica rdf:type owl:ObjectProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :SistemaACS
                                                    :SistemaDeCalefaccion
                                                  )
                                    ] ;
                        rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                            owl:hasValue :tipoFuenteEnergetica
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
                        rdfs:comment "Relaciona un sistema energético con el tipo de fuente energética que utiliza."@es ,
                                     "Relates an energy system to the type of energy source it uses."@en ;
                        rdfs:label "energy source type"@en ,
                                   "tipo de fuente energética"@es .


###  https://w3id.org/miUrba#tipoDeInstalacionComun
:tipoDeInstalacionComun rdf:type owl:ObjectProperty ;
                        rdfs:domain :InstalacionComun ;
                        rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                            owl:hasValue :tipoInstalacion
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
                        rdfs:comment "Relaciona una instalación común con el tipo de instalación que la clasifica."@es ,
                                     "Relates a communal facility to the facility type used to classify it."@en ;
                        rdfs:label "communal facility type"@en ,
                                   "tipo de instalación común"@es .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/miUrba#calificacionEnergetica
:calificacionEnergetica rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Edificio ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Indica la calificación energética asignada a un edificio."@es ,
                                     "Indicates the energy rating assigned to a building."@en ;
                        rdfs:label "calificación energética"@es ,
                                   "energy rating"@en .


###  https://w3id.org/miUrba#conceptoGasto
:conceptoGasto rdf:type owl:DatatypeProperty ;
               rdfs:domain :GastoComunitario ;
               rdfs:range xsd:string ;
               rdfs:comment "Indica el concepto o motivo asociado a un gasto comunitario."@es ,
                            "Indicates the concept or purpose associated with an expense."@en ;
               rdfs:label "concepto del gasto"@es ,
                          "expense concept"@en .


###  https://w3id.org/miUrba#fechaConstruccion
:fechaConstruccion rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Edificio ;
                   rdfs:range xsd:date ;
                   rdfs:comment "Indica la fecha de construcción de un edificio."@es ,
                                "Indicates the construction date of a building."@en ;
                   rdfs:label "construction date"@en ,
                              "fecha de construcción"@es .


###  https://w3id.org/miUrba#fechaReforma
:fechaReforma rdf:type owl:DatatypeProperty ;
              rdfs:domain :Edificio ;
              rdfs:range xsd:date ;
              rdfs:comment "Indica la fecha en la que se realizó una reforma en el edificio."@es ,
                           "Indicates the date on which a renovation was carried out in the building."@en ;
              rdfs:label "fecha de reforma"@es ,
                         "renovation date"@en .


###  https://w3id.org/miUrba#identificadorFiscal
:identificadorFiscal rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Proveedor ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Indica el identificador fiscal de un proveedor."@es ,
                                  "Indicates the tax identifier of a provider."@en ;
                     rdfs:label "identificador fiscal"@es ,
                                "tax identifier"@en .


###  https://w3id.org/miUrba#importe
:importe rdf:type owl:DatatypeProperty ;
         rdfs:domain :GastoComunitario ;
         rdfs:range xsd:decimal ;
         rdfs:comment "Indica el importe económico asociado a un gasto comunitario."@es ,
                      "Indicates the economic amount associated with an expense."@en ;
         rdfs:label "amount"@en ,
                    "importe"@es .


###  https://w3id.org/miUrba#importeTotal
:importeTotal rdf:type owl:DatatypeProperty ;
              rdfs:domain :CuotaComunitaria ;
              rdfs:range xsd:decimal ;
              rdfs:comment "Indica el importe total correspondiente a una cuota comunitaria."@es ,
                           "Indicates the total amount corresponding to a community fee."@en ;
              rdfs:label "importe total"@es ,
                         "total amount"@en .


###  https://w3id.org/miUrba#nombreInstalacion
:nombreInstalacion rdf:type owl:DatatypeProperty ;
                   rdfs:domain :InstalacionComun ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Indica el nombre asignado a una instalación común"@es ,
                                "Indicates the name assigned to a communal facility."@en ;
                   rdfs:label "facility name"@en ,
                              "nombre de la instalación"@es .


###  https://w3id.org/miUrba#nombreProveedor
:nombreProveedor rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Proveedor ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Indica el nombre del proveedor del servicio contratado."@es ,
                              "It indicates the name of the service provider."@en ;
                 rdfs:label "nombre del proveedor"@es ,
                            "provider name"@en .


###  https://w3id.org/miUrba#numeroDePlantas
:numeroDePlantas rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Edificio ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Indica el número de plantas de un edificio"@es ,
                              "Indicates the number of floors in a building."@en ;
                 rdfs:label "number of floors"@en ,
                            "número de plantas"@es .


###  https://w3id.org/miUrba#numeroDeViviendas
:numeroDeViviendas rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Edificio ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Indica el número de viviendas existente en un edificio."@es ,
                                "Indicates the number of dwellings in a building"@en ;
                   rdfs:label "number of dwellings"@en ,
                              "número de viviendas"@es .


###  https://w3id.org/miUrba#observacionesServicio
:observacionesServicio rdf:type owl:DatatypeProperty ;
                       rdfs:domain :ServicioContratado ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Provides additional notes about a contracted service"@en ,
                                    "Recoge observaciones adicionales sobre un servicio contratado."@es ;
                       rdfs:label "observaciones del servicio"@es ,
                                  "service notes"@en .


###  https://w3id.org/miUrba#periodicidad
:periodicidad rdf:type owl:DatatypeProperty ;
              rdfs:domain :CuotaComunitaria ;
              rdfs:range xsd:string ;
              rdfs:comment "Indica la periodicidad con la que debe abonarse una cuota comunitaria."@es ,
                           "Indicates how often a community fee must be paid"@en ;
              rdfs:label "periodicidad"@es ,
                         "periodicity"@en .


###  https://w3id.org/miUrba#tieneAscensor
:tieneAscensor rdf:type owl:DatatypeProperty ;
               rdfs:domain :Edificio ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Indica si un edificio dispone de ascensor"@es ,
                            "Indicates whether a building has a lift"@en ;
               rdfs:label "has lift"@en ,
                          "tiene ascensor"@es .


#################################################################
#    Classes
#################################################################

###  http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralProperty
<http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralProperty> rdf:type owl:Class ;
                                                                          rdfs:comment "Bien inmueble inscrito en el Catastro. Puede ser un local, vivienda, o cualquier unidad de uso independiente dentro de una parcela. Un inmueble catastral puede tener una o más construcciones asociadas."@es ,
                                                                                       "Real estate property registered in the Cadastre. Can be a premises, dwelling, or any independent use unit within a parcel. A cadastral property may have one or more constructions associated."@en ;
                                                                          rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/catastro> ;
                                                                          rdfs:label "Cadastral Property"@en ,
                                                                                     "Inmueble Catastral"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralReference
<http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralReference> rdf:type owl:Class ;
                                                                           rdfs:comment "Abstract parent class for cadastral reference types"@en ,
                                                                                        "Clase padre abstracta para los tipos de referencia catastral."@es ;
                                                                           rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/catastro/> ;
                                                                           rdfs:label "Cadastral Reference"@en ,
                                                                                      "Referencia Catastral"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio> rdf:type owl:Class ;
                                                                                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                rdfs:comment "A neighborhood is each of the parts into which large towns or their districts are divided [source: Dictionary of the Royal Spanish Academy (RAE) 2011]"@en ,
                                                                                             "Un barrio es cada una de las partes en que se dividen los pueblos grandes o sus distritos [fuente: Diccionario de la Real Academia (DRAE) 2011]"@es ;
                                                                                rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                rdfs:label "Barrio"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad> rdf:type owl:Class ;
                                                                                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                rdfs:comment "A city is an urban area where industry and services predominate [source: Wikipedia]"@en ,
                                                                                             "Una ciudad es un área urbana en la que predominan fundamentalmente la industria y los servicios [fuente: Wikipedia]"@es ;
                                                                                rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                rdfs:label "Ciudad"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito> rdf:type owl:Class ;
                                                                                  rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                  rdfs:comment "A district is each of the demarcations into which a territory or population is subdivided to distribute and order the exercise of civil and political rights, or public functions, or administrative services [source: Dictionary of the Royal Spanish Academy 2011]"@en ,
                                                                                               "Un distrito es cada una de las demarcaciones en que se subdivide un territorio o una población para distribuir y ordenar el ejercicio de los derechos civiles y políticos, o de las funciones públicas, o de los servicios administrativos [fuente: Diccionario de la Real Academia (DRAE) 2011]"@es ;
                                                                                  rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                  rdfs:label "Distrito"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                   rdfs:comment "A municipality is the local entity defined in Article 140 of the Spanish Constitution and the basic unit of the State's territorial organization according to Article 1 of Law 7/1985, of April 2, Regulating the Bases of Local Government. It has legal personality and full capacity to fulfill its purposes. The territorial boundaries of municipalities are recorded in the Central Cartographic Registry of the National Geographic Institute (IGN). Its name, specified with the property dct:title, is provided by the Registry of Local Entities of the Ministry of Territorial Policy, at http://www.ine.es/nomen2/index.do"@en ,
                                                                                                "Un Municipio es el ente local definido en el artículo 140 de la Constitución española y la entidad básica de la organización territorial del Estado según el artículo 1 de la Ley 7/1985, de 2 de abril, Reguladora de las Bases del Régimen Local. Tiene personalidad jurídica y plena capacidad para el cumplimiento de sus fines. La delimitación territorial de Municipio está recogida del REgistro Central de Cartografía del IGN. Su nombre, que se especifica con la propiedad dct:title, es el proporcionado por el Registro de Entidades Locales del Ministerio de Política Territorial, en http://www.ine.es/nomen2/index.do"@es ;
                                                                                   rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                   rdfs:label "Municipio"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal
<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal> rdf:type owl:Class ;
                                                                                                           rdfs:comment "A postal address in Spain. It is defined as a specialization of the classes vcard:Address, schema:PostalAddress, and locn:Address. In addition to the properties associated with these classes, and defined in their corresponding vocabulary, those defined in the Spanish administrative division vocabularies and the street directory can also be used."@en ,
                                                                                                                        "Una dirección postal en España. Se define como una especialización de las clases vcard:Address, schema:PostalAddress y locn:Address Además de las propiedades asociadas a estas clases, y definidas en su correspondiente vocabulario, también se pueden utilizar las definidas en los vocabularios de división administrativa española y en el callejero"@es ;
                                                                                                           rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal> ;
                                                                                                           rdfs:label "Dirección postal"@es .


###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class ;
                                               rdfs:comment "A discrete spatial phenomenon that a user interacts with or considers unique in the real world."@en ,
                                                            "Un fenómeno espacial discreto con el que un usuario interactúa o que considera único en el mundo real."@es ;
                                               rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql> ;
                                               rdfs:label "Feature"@en .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class ;
                                                rdfs:comment "A coherent, systematic arrangement of geometric points or cells that represents a spatial location, extent or shape."@en ,
                                                             "Un ordenamiento coherente y sistemático de puntos o celdas geométricas que representa una ubicación, extensión o forma espacial"@es ;
                                                rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql> ;
                                                rdfs:label "Geometry"@en .


