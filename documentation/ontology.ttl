###  https://w3id.org/miUrba#AdministradorFincas
:AdministradorFincas rdf:type owl:Class ;
                     rdfs:subClassOf :RolComunitario ;
                     rdfs:comment "Community role responsible for the administrative and operational management of a homeowners' community."@en ,
                                  "Rol comunitario responsable de la gestión administrativa y operativa de una comunidad de vecinos."@es ;
                     rdfs:label "Administrador de Fincas"@es ,
                                "Property manager"@en .


###  https://w3id.org/miUrba#ComunidadDeVecinos
:ComunidadDeVecinos rdf:type owl:Class ;
                    rdfs:comment "Entidad que representa a una comunidad formada por las personas propietarias de las viviendas."@es ,
                                 "Entity that represents a community made up of the people who own the homes."@en ;
                    rdfs:label "Comunidad de Vecinos"@es ,
                               "Homeowners' community"@en .


###  https://w3id.org/miUrba#Contrato
:Contrato rdf:type owl:Class ;
          rdfs:comment "Acuerdo formal que regula la prestación de un servicio o suministro contratado por una comunidad de vecinos."@es ,
                       "Formal agreement governing the provision of a service or supply contracted by a homeowners' community."@en ;
          rdfs:label "Contract"@en ,
                     "Contrato"@es .


###  https://w3id.org/miUrba#CuotaComunitaria
:CuotaComunitaria rdf:type owl:Class ;
                  rdfs:comment "Amount that a property owner must contribute to the homeowners' community to cover common expenses."@en ,
                               "Importe económico que una persona propietaria debe aportar a la comunidad de vecinos para contribuir a los gastos comunes."@es ;
                  rdfs:label "Community Fee"@en ,
                             "Cuota Comunitaria"@es .


###  https://w3id.org/miUrba#Edificio
:Edificio rdf:type owl:Class ;
          rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
          rdfs:comment "Construcción que agrupa las unidades privativas y los elementos comunes asociados a una comunidad de vecinos."@es ,
                       "Construction that groups the privately owned units and common elements associated with a homeowners' community."@en ;
          rdfs:label "Building"@en ,
                     "Edificio"@es .


###  https://w3id.org/miUrba#GastoComunitario
:GastoComunitario rdf:type owl:Class ;
                  rdfs:comment "Expense associated with the operation, maintenance or management of a homeowners' community."@en ,
                               "Gasto asociado al funcionamiento, mantenimiento o gestión de una comunidad de vecinos."@es ;
                  rdfs:label "Community expense"@en ,
                             "Gasto Comunitario"@es .


###  https://w3id.org/miUrba#GastoExtraordinario
:GastoExtraordinario rdf:type owl:Class ;
                     rdfs:subClassOf :GastoComunitario .


###  https://w3id.org/miUrba#GastoOrdinario
:GastoOrdinario rdf:type owl:Class ;
                rdfs:subClassOf :GastoComunitario .


###  https://w3id.org/miUrba#InstalacionComun
:InstalacionComun rdf:type owl:Class ;
                  rdfs:comment "Espacio o instalación de uso compartido disponible para las personas residentes de una comunidad de vecinos."@es ,
                               "Shared space or facility available for use by the residents of a homeowners' community."@en ;
                  rdfs:label "Communal facility"@en ,
                             "Instalación Común"@es .


###  https://w3id.org/miUrba#PresidenteComunidad
:PresidenteComunidad rdf:type owl:Class ;
                     rdfs:subClassOf :RolComunitario ;
                     rdfs:comment "Community role responsible for representing the homeowners' community and performing the duties associated with its presidency."@en ,
                                  "Rol comunitario encargado de representar a la comunidad de vecinos y ejercer las funciones asociadas a su presidencia."@es ;
                     rdfs:label "President of the homeowners' community"@en ,
                                "Presidente de la Comunidad"@es .


###  https://w3id.org/miUrba#Propietario
:Propietario rdf:type owl:Class ;
             rdfs:subClassOf :RolComunitario ;
             rdfs:comment "Rol ejercido por una persona u organización que posee una vivienda, local u otra unidad privativa perteneciente a una comunidad de vecinos."@es ,
                          "Role performed by a person or organization that owns a dwelling, commercial premises or another privately owned unit within a homeowners' community."@en ;
             rdfs:label "Property owner"@en ,
                        "Propietario"@es .


###  https://w3id.org/miUrba#Proveedor
:Proveedor rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Class ;
                             owl:unionOf ( <https://schema.org/Organization>
                                           <https://schema.org/Person>
                                         )
                           ] ;
           rdfs:comment "Entidad que presta un servicio o suministra un recurso a una comunidad de vecinos"@es ,
                        "Entity that provides a service or supplies a resource to a homeowners' community."@en ;
           rdfs:label "Proveedor"@es ,
                      "Provider"@en .


###  https://w3id.org/miUrba#RolComunitario
:RolComunitario rdf:type owl:Class ;
                rdfs:comment "Función o responsabilidad desempeñada por una persona u organización dentro de una comunidad de vecinos."@es ,
                             "Function or responsibility performed by a person or organization within a homeowners' community."@en ;
                rdfs:label "Community Role"@en ,
                           "Rol Comunitario"@es .


###  https://w3id.org/miUrba#Servicio
:Servicio rdf:type owl:Class ;
          rdfs:comment "A service contracted by a homeowners' community to cover a common need."@en ,
                       "Prestación contratada por una comunidad de vecinos para cubrir una necesidad común."@es ;
          rdfs:label "Service"@en ,
                     "Servicio"@es .


###  https://w3id.org/miUrba#ServicioContratado
:ServicioContratado rdf:type owl:Class ;
                    rdfs:comment "Service whose provision has been agreed through a contract with a homeowners' community."@en ,
                                 "Servicio cuya prestación ha sido acordada mediante un contrato con una comunidad de vecinos."@es ;
                    rdfs:label "Contracted Service"@en ,
                               "Servicio Contratado"@es .


###  https://w3id.org/miUrba#SistemaACS
:SistemaACS rdf:type owl:Class ;
            rdfs:comment "Sistema destinado a producir y suministrar agua caliente sanitaria a un edificio o a sus unidades privativas."@es ,
                         "System intended to produce and supply domestic hot water to a building or its privately owned units."@en ;
            rdfs:label "Domestic hot water system"@en ,
                       "Sistema ACS"@es .


###  https://w3id.org/miUrba#SistemaDeCalefaccion
:SistemaDeCalefaccion rdf:type owl:Class ;
                      rdfs:comment "Sistema destinado a proporcionar calefacción a un edificio o a sus unidades privativas."@es ,
                                   "System intended to provide heating to a building or its private units."@en ;
                      rdfs:label "Heating system"@en ,
                                 "Sistema de calefacción"@es .


