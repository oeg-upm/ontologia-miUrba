        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="es">tiene ascensor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralProperty -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralProperty">
        <rdfs:comment xml:lang="es">Bien inmueble inscrito en el Catastro. Puede ser un local, vivienda, o cualquier unidad de uso independiente dentro de una parcela. Un inmueble catastral puede tener una o más construcciones asociadas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Real estate property registered in the Cadastre. Can be a premises, dwelling, or any independent use unit within a parcel. A cadastral property may have one or more constructions associated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/catastro"/>
        <rdfs:label xml:lang="en">Cadastral Property</rdfs:label>
        <rdfs:label xml:lang="es">Inmueble Catastral</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralReference -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralReference">
        <rdfs:comment xml:lang="en">Abstract parent class for cadastral reference types</rdfs:comment>
        <rdfs:comment xml:lang="es">Clase padre abstracta para los tipos de referencia catastral.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/catastro/"/>
        <rdfs:label xml:lang="en">Cadastral Reference</rdfs:label>
        <rdfs:label xml:lang="es">Referencia Catastral</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A neighborhood is each of the parts into which large towns or their districts are divided [source: Dictionary of the Royal Spanish Academy (RAE) 2011]</rdfs:comment>
        <rdfs:comment xml:lang="es">Un barrio es cada una de las partes en que se dividen los pueblos grandes o sus distritos [fuente: Diccionario de la Real Academia (DRAE) 2011]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio"/>
        <rdfs:label xml:lang="es">Barrio</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A city is an urban area where industry and services predominate [source: Wikipedia]</rdfs:comment>
        <rdfs:comment xml:lang="es">Una ciudad es un área urbana en la que predominan fundamentalmente la industria y los servicios [fuente: Wikipedia]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio"/>
        <rdfs:label xml:lang="es">Ciudad</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A district is each of the demarcations into which a territory or population is subdivided to distribute and order the exercise of civil and political rights, or public functions, or administrative services [source: Dictionary of the Royal Spanish Academy 2011]</rdfs:comment>
        <rdfs:comment xml:lang="es">Un distrito es cada una de las demarcaciones en que se subdivide un territorio o una población para distribuir y ordenar el ejercicio de los derechos civiles y políticos, o de las funciones públicas, o de los servicios administrativos [fuente: Diccionario de la Real Academia (DRAE) 2011]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio"/>
        <rdfs:label xml:lang="es">Distrito</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="es">Un Municipio es el ente local definido en el artículo 140 de la Constitución española y la entidad básica de la organización territorial del Estado según el artículo 1 de la Ley 7/1985, de 2 de abril, Reguladora de las Bases del Régimen Local. Tiene personalidad jurídica y plena capacidad para el cumplimiento de sus fines. La delimitación territorial de Municipio está recogida del REgistro Central de Cartografía del IGN. Su nombre, que se especifica con la propiedad dct:title, es el proporcionado por el Registro de Entidades Locales del Ministerio de Política Territorial, en http://www.ine.es/nomen2/index.do</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio"/>
        <rdfs:isDefinedBy xml:lang="en">A municipality is the local entity defined in Article 140 of the Spanish Constitution and the basic unit of the State&apos;s territorial organization according to Article 1 of Law 7/1985, of April 2, Regulating the Bases of Local Government. It has legal personality and full capacity to fulfill its purposes. The territorial boundaries of municipalities are recorded in the Central Cartographic Registry of the National Geographic Institute (IGN). Its name, specified with the property dct:title, is provided by the Registry of Local Entities of the Ministry of Territorial Policy, at http://www.ine.es/nomen2/index.do</rdfs:isDefinedBy>
        <rdfs:label xml:lang="es">Municipio</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal">
        <rdfs:comment xml:lang="en">A postal address in Spain. It is defined as a specialization of the classes vcard:Address, schema:PostalAddress, and locn:Address. In addition to the properties associated with these classes, and defined in their corresponding vocabulary, those defined in the Spanish administrative division vocabularies and the street directory can also be used.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una dirección postal en España. Se define como una especialización de las clases vcard:Address, schema:PostalAddress y locn:Address Además de las propiedades asociadas a estas clases, y definidas en su correspondiente vocabulario, también se pueden utilizar las definidas en los vocabularios de división administrativa española y en el callejero</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal"/>
        <rdfs:label xml:lang="es">Dirección postal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Feature -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature">
        <rdfs:comment xml:lang="en">A discrete spatial phenomenon that a user interacts with or considers unique in the real world.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un fenómeno espacial discreto con el que un usuario interactúa o que considera único en el mundo real.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql"/>
        <rdfs:label xml:lang="en">Feature</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:comment xml:lang="en">A coherent, systematic arrangement of geometric points or cells that represents a spatial location, extent or shape.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un ordenamiento coherente y sistemático de puntos o celdas geométricas que representa una ubicación, extensión o forma espacial</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql"/>
        <rdfs:label xml:lang="en">Geometry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    </owl:Class>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    </owl:Class>
    


    <!-- https://schema.org/Organization -->

    <owl:Class rdf:about="https://schema.org/Organization">
        <rdfs:comment xml:lang="en">An organization such as a school, NGO, corporation, club, etc.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una organización como una escuela, una ONG, una corporación, un club, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org"/>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Person -->

    <owl:Class rdf:about="https://schema.org/Person">
        <rdfs:comment xml:lang="en">A person (alive, dead, undead, or fictional).</rdfs:comment>
        <rdfs:comment xml:lang="es">Una persona (viva, muerta, no muerta o ficticia).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://schema.org/"/>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#AdministradorFincas -->

    <owl:Class rdf:about="https://w3id.org/miUrba#AdministradorFincas">
        <rdfs:subClassOf rdf:resource="https://w3id.org/miUrba#RolComunitario"/>
        <rdfs:comment xml:lang="en">Person or entity responsible for the administrative and operational management of a homeowners&apos; community.</rdfs:comment>
        <rdfs:comment xml:lang="es">Persona o entidad encargada de la gestión administrativa y operativa de una comunidad de vecinos.</rdfs:comment>
        <rdfs:label xml:lang="es">Administrador de Fincas</rdfs:label>
        <rdfs:label xml:lang="en">Property manager</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#ComunidaDeVecinos -->

    <owl:Class rdf:about="https://w3id.org/miUrba#ComunidaDeVecinos">
        <rdfs:comment xml:lang="es">Entidad que representa a una comunidad formada por las personas propietarias de las viviendas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Entity that represents a community made up of the people who own the homes.</rdfs:comment>
        <rdfs:label xml:lang="es">Comunidad de Vecinos</rdfs:label>
        <rdfs:label xml:lang="en">Homeowners&apos; community</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#Contrato -->

    <owl:Class rdf:about="https://w3id.org/miUrba#Contrato">
        <rdfs:comment xml:lang="es">Acuerdo formal que regula la prestación de un servicio o suministro contratado por una comunidad de vecinos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Formal agreement governing the provision of a service or supply contracted by a homeowners&apos; community.</rdfs:comment>
        <rdfs:label xml:lang="en">Contract</rdfs:label>
        <rdfs:label xml:lang="es">Contrato</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#CuotaComunitaria -->

    <owl:Class rdf:about="https://w3id.org/miUrba#CuotaComunitaria">
        <rdfs:comment xml:lang="en">Amount that a property owner must contribute to the homeowners&apos; community to cover common expenses.</rdfs:comment>
        <rdfs:comment xml:lang="en">Community Fee</rdfs:comment>
        <rdfs:comment xml:lang="es">Importe económico que una persona propietaria debe aportar a la comunidad de vecinos para contribuir a los gastos comunes.</rdfs:comment>
        <rdfs:label xml:lang="es">Cuota Comunitaria</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#Edificio -->

    <owl:Class rdf:about="https://w3id.org/miUrba#Edificio">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="es">Construcción que agrupa las unidades privativas y los elementos comunes asociados a una comunidad de vecinos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Construction that groups together the private units and common elements associated with a community of neighbors.</rdfs:comment>
        <rdfs:label xml:lang="en">Building</rdfs:label>
        <rdfs:label xml:lang="es">Edificio</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#GastoComunitario -->

    <owl:Class rdf:about="https://w3id.org/miUrba#GastoComunitario">
        <rdfs:comment xml:lang="en">Community expense</rdfs:comment>
        <rdfs:comment xml:lang="en">Expense associated with the operation, maintenance or management of a homeowners&apos; community.</rdfs:comment>
        <rdfs:comment xml:lang="es">Gasto asociado al funcionamiento, mantenimiento o gestión de una comunidad de vecinos.</rdfs:comment>
        <rdfs:label xml:lang="es">Gasto Comunitario</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#GastoExtraordinario -->

    <owl:Class rdf:about="https://w3id.org/miUrba#GastoExtraordinario">
        <rdfs:subClassOf rdf:resource="https://w3id.org/miUrba#GastoComunitario"/>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#GastoOrdinario -->

    <owl:Class rdf:about="https://w3id.org/miUrba#GastoOrdinario">
        <rdfs:subClassOf rdf:resource="https://w3id.org/miUrba#GastoComunitario"/>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#InstalacionComun -->

    <owl:Class rdf:about="https://w3id.org/miUrba#InstalacionComun">
        <rdfs:comment xml:lang="en">Communal facility</rdfs:comment>
        <rdfs:comment xml:lang="es">Espacio o instalación de uso compartido disponible para las personas residentes de una comunidad de vecinos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Shared space or facility available for use by the residents of a homeowners</rdfs:comment>
        <rdfs:label xml:lang="es">Instalación Común</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#PartidaDeGasto -->

    <owl:Class rdf:about="https://w3id.org/miUrba#PartidaDeGasto">
        <rdfs:comment xml:lang="en">Concept representing a specific expense borne by a homeowners&apos; community.</rdfs:comment>
        <rdfs:comment xml:lang="es">Concepto que representa un gasto concreto asumido por una comunidad de vecinos.</rdfs:comment>
        <rdfs:label xml:lang="en">Expense item</rdfs:label>
        <rdfs:label xml:lang="es">Partida de Gasto</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#PresidenteComunidad -->

    <owl:Class rdf:about="https://w3id.org/miUrba#PresidenteComunidad">
        <rdfs:subClassOf rdf:resource="https://w3id.org/miUrba#RolComunitario"/>
        <rdfs:comment xml:lang="es">Persona propietaria que representa a la comunidad de vecinos y ejerce las funciones asociadas a su presidencia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Property owner who represents the homeowners&apos; community and performs the duties associated with its presidency.</rdfs:comment>
        <rdfs:label xml:lang="en">President of the homeowners&apos; community</rdfs:label>
        <rdfs:label xml:lang="es">Presidente de la Comunidad</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#Propietario -->

    <owl:Class rdf:about="https://w3id.org/miUrba#Propietario">
        <rdfs:subClassOf rdf:resource="https://w3id.org/miUrba#RolComunitario"/>
        <rdfs:comment xml:lang="en">Person who owns a dwelling, commercial premises or another privately owned unit within a homeowners&apos; community.</rdfs:comment>
        <rdfs:comment xml:lang="es">Persona que posee una vivienda, local u otra unidad privativa perteneciente a una comunidad de vecinos.</rdfs:comment>
        <rdfs:label xml:lang="es">Property owner</rdfs:label>
        <rdfs:label xml:lang="es">Propietario</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#Proveedor -->

    <owl:Class rdf:about="https://w3id.org/miUrba#Proveedor">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://schema.org/Organization"/>
                    <rdf:Description rdf:about="https://schema.org/Person"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="es">Entidad que presta un servicio o suministra un recurso a una comunidad de vecinos</rdfs:comment>
        <rdfs:comment xml:lang="en">Entity that provides a service or supplies a resource to a homeowners&apos; community.</rdfs:comment>
        <rdfs:label xml:lang="es">Proveedor</rdfs:label>
        <rdfs:label xml:lang="en">Provider</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#RolComunitario -->

    <owl:Class rdf:about="https://w3id.org/miUrba#RolComunitario">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://schema.org/Organization"/>
                    <rdf:Description rdf:about="https://schema.org/Person"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="es">Función o responsabilidad desempeñada por una persona dentro de una comunidad de vecinos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Function or responsibility carried out by a person within a homeowners&apos; community.</rdfs:comment>
        <rdfs:label xml:lang="en">Community Role</rdfs:label>
        <rdfs:label xml:lang="es">Rol Comunitario</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#Servicio -->

    <owl:Class rdf:about="https://w3id.org/miUrba#Servicio">
        <rdfs:comment xml:lang="en">A service contracted by a community of neighbors to cover a common need.</rdfs:comment>
        <rdfs:comment xml:lang="es">Prestación contratada por una comunidad de vecinos para cubrir una necesidad común.</rdfs:comment>
        <rdfs:label xml:lang="en">Service</rdfs:label>
        <rdfs:label xml:lang="es">Servicio</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#ServicioContratado -->

    <owl:Class rdf:about="https://w3id.org/miUrba#ServicioContratado">
        <rdfs:comment xml:lang="en">Service whose provision has been agreed through a contract with a community of neighbors.</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio cuya prestación ha sido acordada mediante un contrato con una comunidad de vecinos.</rdfs:comment>
        <rdfs:label xml:lang="en">Contracted Service</rdfs:label>
        <rdfs:label xml:lang="es">Servicio Contratado</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#SistemaACS -->

    <owl:Class rdf:about="https://w3id.org/miUrba#SistemaACS">
        <rdfs:comment xml:lang="es">Sistema destinado a producir y suministrar agua caliente sanitaria a un edificio o a sus unidades privativas.</rdfs:comment>
        <rdfs:comment xml:lang="en">System intended to produce and supply domestic hot water to a building or its privately owned units.</rdfs:comment>
        <rdfs:label xml:lang="en">Domestic hot water system</rdfs:label>
        <rdfs:label xml:lang="es">Sistema ACS</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/miUrba#SistemaDeCalefaccion -->

    <owl:Class rdf:about="https://w3id.org/miUrba#SistemaDeCalefaccion">
        <rdfs:comment xml:lang="es">Sistema destinado a proporcionar calefacción a un edificio o a sus unidades privativas.</rdfs:comment>
        <rdfs:comment xml:lang="en">System intended to provide heating to a building or its private units.</rdfs:comment>
        <rdfs:label xml:lang="en">Heating system</rdfs:label>
        <rdfs:label xml:lang="es">Sistema de calefacción</rdfs:label>
    </owl:Class>
    


