<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/miUrba#"
     xml:base="https://w3id.org/miUrba"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:miUrba="https://w3id.org/miUrba#">
    <owl:Ontology rdf:about="https://w3id.org/miUrba">
        <owl:versionIRI rdf:resource="https://w3id.org/miUrba/1.0.0"/>
        <terms:creator xml:lang="es">Lucía Sánchez-González</terms:creator>
        <terms:creator xml:lang="es">Oscar Corcho</terms:creator>
        <terms:title rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title>miUrba Ontology</terms:title>
        <vann:preferredNamespacePrefix rdf:resource="https://w3id.org/miUrba#"/>
        <vann:preferredNamespacePrefix>miUrba</vann:preferredNamespacePrefix>
        <owl:versionIRI>1.0.0</owl:versionIRI>
        <owl:versionIRI xml:lang="es">Ontología para describir comunidades de vecinos.</owl:versionIRI>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionIRI -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionIRI"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionInfo -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date">
        <rdfs:label xml:lang="es">identificador fiscal</rdfs:label>
    </rdfs:Datatype>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment xml:lang="es">Una representación espacial de un feature determinado.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0"/>
        <rdfs:label xml:lang="en">has geometry</rdfs:label>
        <rdfs:label xml:lang="es">tiene geometría</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/infraestructura#belongsTo -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/infraestructura#belongsTo">
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio"/>
        <rdfs:comment xml:lang="es">Relación entre un elemento de infraestructura y la división administrativa a la cual pertenece, incluido un Barrio.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between an infrastructure element and the administrative division to which it belongs, including a neighborhood.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://edint.es/def/infraestructura#"/>
        <rdfs:label xml:lang="en">belongs To</rdfs:label>
        <rdfs:label xml:lang="es">pertenece a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/address -->

    <owl:ObjectProperty rdf:about="https://schema.org/address">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Edificio"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal"/>
        <rdfs:comment xml:lang="es">Dirección física del elemento</rdfs:comment>
        <rdfs:comment xml:lang="en">Physical address of the item.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/"/>
        <rdfs:label xml:lang="en">address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#correspondeAComunidad -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#correspondeAComunidad">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#PartidaDeGasto"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#ComunidaDeVecinos"/>
        <rdfs:comment xml:lang="es">Relaciona una partida de gasto con la comunidad de vecinos a la que corresponde.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an expense item to the homeowners&apos; community to which it corresponds</rdfs:comment>
        <rdfs:label xml:lang="es">corresponde a comunidad</rdfs:label>
        <rdfs:label xml:lang="en">corresponds to homeowners&apos; community</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#correspondeAServicio -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#correspondeAServicio">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ServicioContratado"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#Servicio"/>
        <rdfs:comment xml:lang="es">Relaciona un servicio contratado con el servicio al que corresponde</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a contracted service to the service it corresponds to</rdfs:comment>
        <rdfs:label xml:lang="es">corresponde a servicio</rdfs:label>
        <rdfs:label xml:lang="en">corresponds to service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#correspondeAServicioContratado -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#correspondeAServicioContratado">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#PartidaDeGasto"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#ServicioContratado"/>
        <rdfs:comment xml:lang="es">Relaciona una partida de gasto con el servicio contratado al que corresponde.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an expense item to the contracted service to which it corresponds.</rdfs:comment>
        <rdfs:label xml:lang="es">corresponde a servicio contratado</rdfs:label>
        <rdfs:label xml:lang="en">corresponds to contracted service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#cubreInstalacionComun -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#cubreInstalacionComun">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ServicioContratado"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#InstalacionComun"/>
        <rdfs:comment xml:lang="es">Relaciona un servicio con la instalación común sobre la que se presta o actúa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a service to the communal facility on which it is provided or acts.</rdfs:comment>
        <rdfs:label xml:lang="en">covers communal facility</rdfs:label>
        <rdfs:label xml:lang="es">cubre instalación común</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#disponeDeInstalacionComun -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#disponeDeInstalacionComun">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Edificio"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#InstalacionComun"/>
        <rdfs:comment xml:lang="es">Relaciona una comunidad de vecinos con una instalación común disponible para sus residentes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a homeowners&apos; community to a communal facility available to its residents.</rdfs:comment>
        <rdfs:label xml:lang="es">dispone de instalación común</rdfs:label>
        <rdfs:label xml:lang="en">has communal facility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#formadaPor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#formadaPor">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ComunidaDeVecinos"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#Edificio"/>
        <rdfs:comment xml:lang="es">Relaciona una comunidad de vecinos con los edificios que la conforman.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a homeowners&apos; community to the buildings that compose it</rdfs:comment>
        <rdfs:label xml:lang="en">composed of</rdfs:label>
        <rdfs:label xml:lang="es">formado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#modalidadDeServicio -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#modalidadDeServicio">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ServicioContratado"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://w3id.org/miUrba#modalidadServicio"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona un servicio contratado con la modalidad bajo la que se presta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a contracted service to the modality under which it is provided.</rdfs:comment>
        <rdfs:label xml:lang="es">modalidad de servicio</rdfs:label>
        <rdfs:label xml:lang="en">service modality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#modalidadDeSuministro -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#modalidadDeSuministro">
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://w3id.org/miUrba#modalidadSuministro"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona un sistema térmico con la modalidad mediante la que se suministra calefacción o agua caliente sanitaria.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a thermal system to the modality through which heating or domestic hot water is supplied.</rdfs:comment>
        <rdfs:label xml:lang="es">modalidad de suministro</rdfs:label>
        <rdfs:label xml:lang="en">supply modality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#prestadoPor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#prestadoPor">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ServicioContratado"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#Proveedor"/>
        <rdfs:comment xml:lang="es">Relaciona un servicio contratado con el proveedor encargado de prestarlo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a contracted service to the provider responsible for delivering it.</rdfs:comment>
        <rdfs:label xml:lang="es">prestado por</rdfs:label>
        <rdfs:label xml:lang="en">provided by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneContrato -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneContrato">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ServicioContratado"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#Contrato"/>
        <rdfs:comment xml:lang="es">Relaciona un servicio contratado con el contrato que regula su prestación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a contracted service to the contract that governs its provision.</rdfs:comment>
        <rdfs:label xml:lang="en">has contract</rdfs:label>
        <rdfs:label xml:lang="es">tiene Contrato</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneCuotaComunitaria -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneCuotaComunitaria">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ComunidaDeVecinos"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#CuotaComunitaria"/>
        <rdfs:comment xml:lang="es">Relaciona una comunidad de vecinos con una cuota comunitaria asociada.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a homeowners&apos; community to an associated community fee.</rdfs:comment>
        <rdfs:label xml:lang="en">has community fee</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuota comunitaria</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneFrecuenciaDeServicio -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneFrecuenciaDeServicio">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ServicioContratado"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://w3id.org/miUrba#frecuenciaServicio"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona un servicio contratado con la frecuencia con la que se presta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a contracted service to the frequency at which it is provided.</rdfs:comment>
        <rdfs:label xml:lang="en">has service frequency</rdfs:label>
        <rdfs:label xml:lang="es">tiene frecuencia de servicio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneGastoComunitario -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneGastoComunitario">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ComunidaDeVecinos"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#GastoComunitario"/>
        <rdfs:comment xml:lang="es">Relaciona una comunidad de vecinos con un gasto comunitario asociado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a homeowners&apos; community to an associated community expense</rdfs:comment>
        <rdfs:label xml:lang="en">has community expense</rdfs:label>
        <rdfs:label xml:lang="es">tiene gasto comunitario</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneInmueble -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneInmueble">
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralProperty"/>
        <rdfs:comment xml:lang="es">Relaciona un edificio con el inmueble catastral que lo representa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a building to the cadastral property that represents it.</rdfs:comment>
        <rdfs:label xml:lang="en">has cadastral property</rdfs:label>
        <rdfs:label xml:lang="es">tiene inmueble</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneReferenciaCatastral -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneReferenciaCatastral">
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralReference"/>
        <rdfs:comment xml:lang="es">Relaciona un inmueble con su referencia catastral.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a property to its cadastral reference.</rdfs:comment>
        <rdfs:label xml:lang="en">has cadastral reference</rdfs:label>
        <rdfs:label xml:lang="es">tiene referencia catastral</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneRol -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneRol">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#ComunidaDeVecinos"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#RolComunitario"/>
        <rdfs:comment xml:lang="es">Relaciona una persona con el rol que desempeña dentro de una comunidad de vecinos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a person to the role they perform within a homeowners&apos; community.</rdfs:comment>
        <rdfs:label xml:lang="en">has role</rdfs:label>
        <rdfs:label xml:lang="es">tiene rol</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneSistemaDeACS -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneSistemaDeACS">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Edificio"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#SistemaACS"/>
        <rdfs:comment xml:lang="es">Relaciona un edificio con su sistema de agua caliente sanitaria.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a building to its domestic hot water system.</rdfs:comment>
        <rdfs:label xml:lang="en">has domestic hot water system</rdfs:label>
        <rdfs:label xml:lang="es">tiene sistema de ACS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneSistemaDeCalefaccion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneSistemaDeCalefaccion">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Edificio"/>
        <rdfs:range rdf:resource="https://w3id.org/miUrba#SistemaDeCalefaccion"/>
        <rdfs:comment xml:lang="es">Relaciona un edificio con su sistema de calefacción.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a building to its heating system.</rdfs:comment>
        <rdfs:label xml:lang="en">has heating system</rdfs:label>
        <rdfs:label xml:lang="es">tiene sistema de calefacción</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneTipoDeServicio -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneTipoDeServicio">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Servicio"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://w3id.org/miUrba#tipoServicio"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona un servicio con el tipo de servicio que lo clasifica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a service to the service type used to classify it</rdfs:comment>
        <rdfs:label xml:lang="en">has service type</rdfs:label>
        <rdfs:label xml:lang="es">tiene tipo de servicio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tipoDeFuenteEnergetica -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tipoDeFuenteEnergetica">
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://w3id.org/miUrba#tipoFuenteEnergetica"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona un sistema energético con el tipo de fuente energética que utiliza.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an energy system to the type of energy source it uses.</rdfs:comment>
        <rdfs:label xml:lang="en">energy source type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de fuente energética</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tipoDeInstalacionComun -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tipoDeInstalacionComun">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#InstalacionComun"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://w3id.org/miUrba#tipoInstalacion"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona una instalación común con el tipo de instalación que la clasifica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a communal facility to the facility type used to classify it.</rdfs:comment>
        <rdfs:label xml:lang="en">communal facility type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de instalación común</rdfs:label>
    </owl:ObjectProperty>
    


