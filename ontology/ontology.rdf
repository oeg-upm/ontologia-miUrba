    <!-- https://schema.org/address -->

    <owl:ObjectProperty rdf:about="https://schema.org/address">
        <rdfs:comment xml:lang="es">Dirección física del elemento</rdfs:comment>
        <rdfs:comment xml:lang="en">Physical address of the item.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/"/>
        <rdfs:label xml:lang="en">address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneInmueble -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneInmueble">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Edificio"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralProperty"/>
        <rdfs:label rdf:resource="tiene inmueble"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/miUrba#tieneReferenciaCatastral -->

    <owl:ObjectProperty rdf:about="https://w3id.org/miUrba#tieneReferenciaCatastral">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Edificio"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/catastro/CadastralReference"/>
        <rdfs:label xml:lang="es">tiene referencia catastral</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
