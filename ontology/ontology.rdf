    <!-- https://w3id.org/miUrba#frecuenciaServicio -->

    <owl:NamedIndividual rdf:about="https://w3id.org/miUrba#frecuenciaServicio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:comment xml:lang="es">Este esquema de conceptos pertenece al conjunto de vocabularios controlados basados en SKOS utilizados por la ontología miUrba para representar comunidades de vecinos</rdfs:comment>
        <rdfs:comment xml:lang="en">This concept scheme belongs to the set of SKOS-based controlled vocabularies used by the miUrba ontology to represent homeowners&apos; communities.</rdfs:comment>
        <rdfs:label xml:lang="es">Frecuencia de Servicio</rdfs:label>
        <rdfs:label xml:lang="en">Service frequency</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/miUrba#modalidadServicio -->

    <owl:NamedIndividual rdf:about="https://w3id.org/miUrba#modalidadServicio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:comment xml:lang="es">Este esquema de conceptos pertenece al conjunto de vocabularios controlados basados en SKOS utilizados por la ontología miUrba para representar comunidades de vecinos. Esquema de conceptos que agrupa modalidades de prestación de servicios en comunidades de vecinos</rdfs:comment>
        <rdfs:comment xml:lang="en">This concept scheme belongs to the set of SKOS-based controlled vocabularies used by the miUrba ontology to represent homeowners&apos; communities. Concept scheme grouping service provision modalities in homeowners</rdfs:comment>
        <rdfs:label xml:lang="es">Modalidad de Servicio</rdfs:label>
        <rdfs:label xml:lang="en">Service Modality</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/miUrba#modalidadSuministro -->

    <owl:NamedIndividual rdf:about="https://w3id.org/miUrba#modalidadSuministro">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:comment xml:lang="es">Este esquema de conceptos pertenece al conjunto de vocabularios controlados basados en SKOS utilizados por la ontología miUrba para representar comunidades de vecinos. Esquema de conceptos que agrupa modalidades de suministro térmico para sistemas de calefacción y agua caliente sanitaria en edificios residenciales.</rdfs:comment>
        <rdfs:comment xml:lang="en">This concept scheme belongs to the set of controlled vocabularies based on SKOS used by the miUrba ontology to represent residential communities. It groups thermal supply modalities for heating and domestic hot water systems in residential buildings.</rdfs:comment>
        <rdfs:label xml:lang="es">Modalidad de Suministro Térmico</rdfs:label>
        <rdfs:label xml:lang="en">Thermal supply modality</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/miUrba#tipoFuenteEnergetica -->

    <owl:NamedIndividual rdf:about="https://w3id.org/miUrba#tipoFuenteEnergetica">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:comment xml:lang="es">Este esquema de conceptos pertenece al conjunto de vocabularios controlados basados en SKOS utilizados por la ontología miUrba para representar comunidades de vecinos. Esquema de conceptos que agrupa tipos de fuentes energéticas utilizadas en sistemas de edificios residenciales.</rdfs:comment>
        <rdfs:comment xml:lang="en">This concept scheme belongs to the set of controlled vocabularies based on SKOS used by the miUrba ontology to represent residential communities. It groups types of energy sources used in residential building systems.</rdfs:comment>
        <rdfs:label xml:lang="en">Energy Source Type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de Fuente Energética</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/miUrba#tipoInstalacion -->

    <owl:NamedIndividual rdf:about="https://w3id.org/miUrba#tipoInstalacion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:comment xml:lang="es">Este esquema de conceptos pertenece al conjunto de vocabularios controlados basados en SKOS utilizados por la ontología miUrba para representar comunidades de vecinos. Esquema de conceptos que agrupa tipos de instalaciones comunitarias disponibles en comunidades de vecinos.</rdfs:comment>
        <rdfs:comment xml:lang="en">This concept scheme belongs to the set of controlled vocabularies based on SKOS used by the miUrba ontology to represent residential communities. It groups the types of community facilities available in residential communities.</rdfs:comment>
        <rdfs:label xml:lang="en">Community Facility Type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de Instalación Común</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/miUrba#tipoServicio -->

    <owl:NamedIndividual rdf:about="https://w3id.org/miUrba#tipoServicio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:comment xml:lang="es">Este esquema conceptual pertenece al conjunto de vocabularios controlados basados ​​en SKOS que utiliza la ontología miUrba para representar las comunidades de propietarios de viviendas. Esquema conceptual que agrupa los tipos de servicios contratados por los propietarios.</rdfs:comment>
        <rdfs:comment xml:lang="en">This concept scheme belongs to the set of SKOS-based controlled vocabularies used by the miUrba ontology to represent homeowners&apos; communities. Concept scheme grouping types of services contracted by homeowners.</rdfs:comment>
        <rdfs:label xml:lang="en">Service Type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de Servicio</rdfs:label>
    </owl:NamedIndividual>
