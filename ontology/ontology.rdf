    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/miUrba#nombreProveedor -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/miUrba#nombreProveedor">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Proveedor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="es">nombre del proveedor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/miUrba#numeroDePlantas -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/miUrba#numeroDePlantas">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Edificio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="es">número de plantas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/miUrba#numeroDeViviendas -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/miUrba#numeroDeViviendas">
        <rdfs:domain rdf:resource="https://w3id.org/miUrba#Edificio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="es">número de viviendas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/miUrba#tieneAscensor -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/miUrba#tieneAscensor">
