miUrbainstalacion:salaMultiusos
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Sala multiusos"@es ;
    skos:prefLabel "Multipurpose room"@en ;
    skos:definition
        "Recinto comunitario acondicionado para la realización de diferentes actividades sociales, vecinales o recreativas."@es ;
    skos:definition
        "Communal room designed for different social, community or recreational activities."@en .

miUrbainstalacion:clubSocial
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Club social"@es ;
    skos:prefLabel "Residents' club"@en ;
    skos:definition
        "Espacio comunitario acondicionado para la convivencia, reunión y ocio de las personas residentes."@es ;
    skos:definition
        "Communal space designed for residents' social interaction, gatherings and leisure."@en .

miUrbainstalacion:salaReuniones
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Sala de reuniones"@es ;
    skos:prefLabel "Meeting room"@en ;
    skos:definition
        "Recinto comunitario acondicionado para la celebración de reuniones."@es ;
    skos:definition
        "Communal room designed for holding meetings."@en .

miUrbainstalacion:salaJuegos
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Sala de juegos"@es ;
    skos:prefLabel "Games room"@en ;
    skos:definition
        "Recinto comunitario acondicionado para actividades recreativas y juegos."@es ;
    skos:definition
        "Communal room designed for games and recreational activities."@en .

miUrbainstalacion:salaCine
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Sala de cine"@es ;
    skos:prefLabel "Cinema room"@en ;
    skos:definition
        "Recinto comunitario equipado para la proyección y visualización de contenidos audiovisuales."@es ;
    skos:definition
        "Communal room equipped for the projection and viewing of audiovisual content."@en .

miUrbainstalacion:gastroteca
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Gastroteca"@es ;
    skos:prefLabel "Communal kitchen and dining area"@en ;
    skos:definition
        "Espacio comunitario equipado para cocinar, comer y celebrar encuentros gastronómicos."@es ;
    skos:definition
        "Communal space equipped for cooking, dining and holding food-related gatherings."@en .

miUrbainstalacion:zonaCelebracionEventos
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Zona de celebración de eventos"@es ;
    skos:prefLabel "Event area"@en ;
    skos:definition
        "Espacio comunitario acondicionado para la organización de celebraciones o eventos."@es ;
    skos:definition
        "Communal space designed for organising celebrations or events."@en .

miUrbainstalacion:espacioCoworking
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Espacio de coworking"@es ;
    skos:prefLabel "Coworking space"@en ;
    skos:definition
        "Espacio comunitario acondicionado para el trabajo individual o compartido de las personas residentes."@es ;
    skos:definition
        "Communal space designed for individual or shared work by residents."@en .

miUrbainstalacion:salaEstudio
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Sala de estudio"@es ;
    skos:prefLabel "Study room"@en ;
    skos:definition
        "Recinto comunitario acondicionado para el estudio, la lectura o el trabajo individual."@es ;
    skos:definition
        "Communal room designed for studying, reading or individual work."@en .

miUrbainstalacion:jardinComunitario
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Jardín comunitario"@es ;
    skos:prefLabel "Communal garden"@en ;
    skos:definition
        "Espacio común ajardinado destinado al uso y disfrute de las personas residentes."@es ;
    skos:definition
        "Landscaped communal space intended for residents' use and enjoyment."@en .

miUrbainstalacion:zonaAjardinada
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Zona ajardinada"@es ;
    skos:prefLabel "Landscaped area"@en ;
    skos:definition
        "Área común provista de vegetación ornamental, no necesariamente destinada a la estancia o al uso recreativo."@es ;
    skos:definition
        "Common area containing ornamental vegetation, not necessarily intended for recreation or prolonged use."@en .

miUrbainstalacion:solarium
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Solárium"@es ;
    skos:prefLabel "Solarium"@en ;
    skos:definition
        "Espacio comunitario acondicionado para tomar el sol y descansar."@es ;
    skos:definition
        "Communal space designed for sunbathing and relaxation."@en .

miUrbainstalacion:terrazaComunitaria
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Terraza comunitaria"@es ;
    skos:prefLabel "Communal terrace"@en ;
    skos:definition
        "Espacio exterior común y accesible acondicionado para el uso de las personas residentes."@es ;
    skos:definition
        "Accessible outdoor communal space designed for residents' use."@en .

miUrbainstalacion:zonaChillOut
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Zona chill-out"@es ;
    skos:prefLabel "Chill-out area"@en ;
    skos:definition
        "Espacio comunitario acondicionado para el descanso y la convivencia informal."@es ;
    skos:definition
        "Communal space designed for relaxation and informal social interaction."@en .

miUrbainstalacion:zonaBarbacoa
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Zona de barbacoa"@es ;
    skos:prefLabel "Barbecue area"@en ;
    skos:definition
        "Espacio comunitario acondicionado para la preparación de alimentos mediante barbacoa."@es ;
    skos:definition
        "Communal space equipped for preparing food using a barbecue."@en .

miUrbainstalacion:huertoComunitario
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Huerto comunitario"@es ;
    skos:prefLabel "Communal vegetable garden"@en ;
    skos:definition
        "Espacio común acondicionado para el cultivo de plantas por parte de las personas residentes."@es ;
    skos:definition
        "Communal space prepared for residents to grow plants or vegetables."@en .

miUrbainstalacion:parqueCanino
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Parque canino"@es ;
    skos:prefLabel "Dog park"@en ;
    skos:definition
        "Espacio común delimitado y acondicionado para el ejercicio y esparcimiento de perros."@es ;
    skos:definition
        "Delimited communal space designed for dogs to exercise and play."@en .

miUrbainstalacion:aparcamientoBicicletas
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Aparcamiento para bicicletas"@es ;
    skos:prefLabel "Bicycle parking"@en ;
    skos:altLabel "Aparcabicicletas"@es ;
    skos:definition
        "Espacio comunitario acondicionado para estacionar bicicletas."@es ;
    skos:definition
        "Communal space designed for parking bicycles."@en .

miUrbainstalacion:cuartoBicicletas
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Cuarto de bicicletas"@es ;
    skos:prefLabel "Bicycle storage room"@en ;
    skos:altLabel "Cuarto de bicis"@es ;
    skos:definition
        "Recinto comunitario cerrado destinado al almacenamiento de bicicletas."@es ;
    skos:definition
        "Enclosed communal room intended for bicycle storage."@en .

miUrbainstalacion:aparcamientoPatinetes
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Aparcamiento para patinetes"@es ;
    skos:prefLabel "Scooter parking"@en ;
    skos:definition
        "Espacio comunitario acondicionado para estacionar patinetes."@es ;
    skos:definition
        "Communal space designed for parking scooters."@en .