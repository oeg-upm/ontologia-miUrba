@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .

@prefix miUrba: <https://w3id.org/def/miUrba#> .
@prefix miUrbakos: <https://w3id.org/def/kos/miUrba/> .
@prefix miUrbainstalacion: <https://w3id.org/def/kos/miUrba/TipoInstalacion/> .


#################################################################
#
#    Concept Scheme
#
#################################################################

miUrbakos:TipoInstalacion
    a skos:ConceptScheme ;
    dct:issued "2026-08-17"^^xsd:date ;
    dct:modified "2026-08-17"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;

    rdfs:comment
        "This concept scheme belongs to the set of SKOS-based controlled vocabularies used by the miUrba ontology to represent homeowners' communities."@en ;
    rdfs:comment
        "Este esquema de conceptos pertenece al conjunto de vocabularios controlados basados en SKOS utilizados por la ontología miUrba para representar comunidades de vecinos."@es ;

    rdfs:label "Tipos de instalación comunitaria"@es ;
    rdfs:label "Community facility types"@en ;

    dct:title
        "Concept scheme grouping types of communal facilities available in homeowners' communities"@en ;
    dct:title
        "Esquema de conceptos que agrupa tipos de instalaciones comunitarias disponibles en comunidades de vecinos"@es .


#################################################################
#
#    Concepts
#
#################################################################

miUrbainstalacion:piscina
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Piscina"@es ;
    skos:prefLabel "Swimming pool"@en ;
    skos:definition
        "Instalación acuática común destinada al baño, la natación o el ocio de las personas residentes."@es ;
    skos:definition
        "Communal aquatic facility intended for bathing, swimming or leisure activities by residents."@en .

miUrbainstalacion:piscinaInfantil
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Piscina infantil"@es ;
    skos:prefLabel "Children's swimming pool"@en ;
    skos:definition
        "Piscina comunitaria diseñada o acondicionada para el uso de menores."@es ;
    skos:definition
        "Communal swimming pool designed or adapted for use by children."@en .

miUrbainstalacion:piscinaCubierta
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Piscina cubierta"@es ;
    skos:prefLabel "Indoor swimming pool"@en ;
    skos:definition
        "Piscina comunitaria situada en un recinto cubierto."@es ;
    skos:definition
        "Communal swimming pool located within a covered or enclosed space."@en .

miUrbainstalacion:piscinaClimatizada
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Piscina climatizada"@es ;
    skos:prefLabel "Heated swimming pool"@en ;
    skos:definition
        "Piscina comunitaria equipada con un sistema de regulación de la temperatura del agua."@es ;
    skos:definition
        "Communal swimming pool equipped with a system for regulating water temperature."@en .

miUrbainstalacion:jacuzzi
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Jacuzzi"@es ;
    skos:prefLabel "Hot tub"@en ;
    skos:altLabel "Bañera de hidromasaje"@es ;
    skos:altLabel "Whirlpool bath"@en ;
    skos:definition
        "Instalación comunitaria de baño equipada con chorros de agua o aire a presión."@es ;
    skos:definition
        "Communal bathing facility equipped with pressurised water or air jets."@en .

miUrbainstalacion:spa
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Spa"@es ;
    skos:prefLabel "Spa"@en ;
    skos:definition
        "Espacio comunitario acondicionado con instalaciones destinadas al bienestar y la relajación."@es ;
    skos:definition
        "Communal space equipped with facilities intended for wellness and relaxation."@en .

miUrbainstalacion:sauna
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Sauna"@es ;
    skos:prefLabel "Sauna"@en ;
    skos:definition
        "Recinto comunitario acondicionado para baños de calor."@es ;
    skos:definition
        "Communal room designed for heat bathing."@en .

miUrbainstalacion:gimnasio
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Gimnasio"@es ;
    skos:prefLabel "Gym"@en ;
    skos:definition
        "Recinto comunitario equipado para la práctica de ejercicio físico."@es ;
    skos:definition
        "Communal room equipped for physical exercise."@en .

miUrbainstalacion:pistaPadel
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Pista de pádel"@es ;
    skos:prefLabel "Padel court"@en ;
    skos:definition
        "Instalación deportiva comunitaria acondicionada para la práctica del pádel."@es ;
    skos:definition
        "Communal sports facility designed for playing padel."@en .

miUrbainstalacion:pistaTenis
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Pista de tenis"@es ;
    skos:prefLabel "Tennis court"@en ;
    skos:definition
        "Instalación deportiva comunitaria acondicionada para la práctica del tenis."@es ;
    skos:definition
        "Communal sports facility designed for playing tennis."@en .

miUrbainstalacion:pistaSquash
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Pista de squash"@es ;
    skos:prefLabel "Squash court"@en ;
    skos:definition
        "Instalación deportiva comunitaria acondicionada para la práctica del squash."@es ;
    skos:definition
        "Communal sports facility designed for playing squash."@en .

miUrbainstalacion:pistaPolideportiva
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Pista polideportiva"@es ;
    skos:prefLabel "Multi-sport court"@en ;
    skos:definition
        "Instalación deportiva comunitaria acondicionada para la práctica de diferentes deportes."@es ;
    skos:definition
        "Communal sports facility designed for the practice of different sports."@en .

miUrbainstalacion:zonaEjercicioAireLibre
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Zona de ejercicio al aire libre"@es ;
    skos:prefLabel "Outdoor exercise area"@en ;
    skos:definition
        "Espacio comunitario exterior equipado o acondicionado para la práctica de ejercicio físico."@es ;
    skos:definition
        "Outdoor communal area equipped or adapted for physical exercise."@en .

miUrbainstalacion:zonaJuegosInfantiles
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Zona de juegos infantiles"@es ;
    skos:prefLabel "Children's play area"@en ;
    skos:altLabel "Parque infantil"@es ;
    skos:altLabel "Playground"@en ;
    skos:definition
        "Espacio comunitario acondicionado con elementos de juego destinados a menores."@es ;
    skos:definition
        "Communal area equipped with play elements intended for children."@en .

miUrbainstalacion:salaInfantil
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Sala infantil"@es ;
    skos:prefLabel "Children's room"@en ;
    skos:definition
        "Recinto comunitario interior acondicionado para el uso y entretenimiento de menores."@es ;
    skos:definition
        "Indoor communal room designed for children's use and recreation."@en .

miUrbainstalacion:ludoteca
    a skos:Concept ;
    skos:inScheme miUrbakos:TipoInstalacion ;
    skos:prefLabel "Ludoteca"@es ;
    skos:prefLabel "Playroom"@en ;
    skos:definition
        "Espacio comunitario acondicionado para el juego y la realización de actividades infantiles."@es ;
    skos:definition
